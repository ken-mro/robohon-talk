<?xml version="1.0" ?>
<hvml version="2.0">
    <head>
        <producer>com.robohon.template</producer>
        <description>ホーム起動シナリオ</description>
        <scene value="home"/>
        <version value="1.1"/>
        <!-- 起動ワードは固定文言「領域展開」。旧方式（ロボホン名の __ROBO_KANA__ 置換）は
             本体標準の呼びかけ応答と競合して起動しづらいため廃止した。 -->
        <situation priority="78" topic_id="start" trigger="user-word">${Local:WORD_APPLICATION} eq りょういきてんかい</situation>
        <situation priority="78" topic_id="start" trigger="user-word">${Local:WORD_APPLICATION_FREEWORD} eq りょういきてんかいして</situation>
    </head>
    <body>
        <topic id="start" listen="false">
            <!-- ここでは返事を言わせず、うなずきモーションのみ。
                 口上はアプリ起動後の greet（「いくよ……領域展開！――無限対話空間！」）に集約する。 -->
            <action index="1">
                <behavior id="${resolver:motion_ok(${resolver:ok_id})}" type="normal"/>
            </action>
            <action index="2">
                <behavior id="assign" type="normal"/>
                <control function="start_activity" target="home">
                    <data key="package_name" value="com.robohon.template"/>
                    <data key="class_name" value="com.robohon.template.MainActivity"/>
                </control>
            </action>
        </topic>
    </body>
</hvml>
